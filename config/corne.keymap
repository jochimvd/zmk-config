// Selenium (home row mods flavor), ported from https://github.com/OneDeadKey/zmk-config-aekeynox
// QWERTY alphas, US QWERTY host layout, stock ZMK behaviors only.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE        0
#define NUMLOCK     1
#define SYM         2
#define NAVNUM      3
#define FNMEDIA     4
#define GAME        5

// Timing is key!
#define TAPPING_TERM        300  // tap-preferred hold-taps: home row mods, Space, sticky Shift/Sym
#define SHORT_TAPPING_TERM  150  // hold-preferred hold-taps: Backspace, Tab, Enter
#define QUICK_TAP           200

&lt {
    tapping-term-ms = <TAPPING_TERM>;
    quick-tap-ms = <QUICK_TAP>;
};

&mt {
    tapping-term-ms = <SHORT_TAPPING_TERM>;
    quick-tap-ms = <QUICK_TAP>;
};

&sl { ignore-modifiers; };  // keep sticky mods when chained into a sticky layer
&sk { quick-release; };     // release the sticky mod as soon as the next key is pressed

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP>;
            bindings = <&kp>, <&kp>;
        };

        sc: space_cadet {  // same as lt, but hold-preferred: layer unless tapped quickly
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <SHORT_TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP>;
            bindings = <&mo>, <&kp>;
        };

        // Sticky layer / sticky key with a more robust timing: tap = one-shot, hold = momentary
        osl: one_shot_layer {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&macro_param_1to1>, <&macro_tap &sl MACRO_PLACEHOLDER>;
        };

        bsl: better_sticky_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            bindings = <&mo>, <&osl>;
        };

        osm: one_shot_modifier {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&macro_param_1to1>, <&macro_tap &sk MACRO_PLACEHOLDER>;
        };

        bsk: better_sticky_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            hold-while-undecided;
            bindings = <&kp>, <&osm>;
        };

        shift_caps: shift_caps {  // tap: sticky shift | double tap: caps word
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bsk LSHFT LSHFT>, <&unshift_caps>;
            mods = <(MOD_LSFT)>;
        };

        unshift_caps: unshift_caps {  // drop the pending sticky shift, then enable caps word
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp K_CANCEL>, <&caps_word>;
        };

        // Go back to the base layer, then press (hold) or stick (tap) a modifier
        lkp: goto_layer_then_keypress {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_tap &to BASE>
                , <&macro_param_1to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                ;
        };

        losm: goto_layer_then_osm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_tap &to BASE>
                , <&macro_param_1to1>
                , <&macro_tap &sk MACRO_PLACEHOLDER>
                ;
        };

        lbsk: bsk_on_other_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            bindings = <&lkp>, <&losm>;
        };

        bt_sel1_clr: bt_sel1_clr {  // tap: BT profile 1 | shift + tap: clear profile
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt BT_CLR>;
            mods = <(MOD_LSFT)>;
        };
    };

// Selenium HRM: pinky -, ring GUI, middle Ctrl, index Alt; Shift and Sym are sticky thumb keys
//
//   Tab  q w e r t   y u i o p  Bspc
//   Esc  a s d f g   h j k l ;  Ret
//   ⇧    z x c v b   n m , . /  ⇧
//    ⇧ Bspc/NavNum Tab/FnMedia   Ret/FnMedia Spc/NavNum Sym

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W       &kp E        &kp R       &kp T            &kp Y          &kp U       &kp I        &kp O       &kp P     &kp BSPC
&kp ESC    &kp A  &hm LGUI S  &hm LCTRL D  &hm LALT F  &kp G            &kp H          &hm LALT J  &hm LCTRL K  &hm LGUI L  &kp SEMI  &kp RET
&kp LSHFT  &kp Z  &kp X       &kp C        &kp V       &kp B            &kp N          &kp M       &kp COMMA    &kp DOT     &kp FSLH  &kp RSHFT
                              &shift_caps  &sc NAVNUM BSPC  &sc FNMEDIA TAB  &sc FNMEDIA RET  &lt NAVNUM SPACE  &bsl SYM SYM
            >;
        };

        numlock_layer {  // NavNum that stays on until exited with the top-left key of the right hand
            display-name = "NumLock";
            bindings = <
&trans  &kp ESC     &kp HOME   &kp UP    &kp END    &kp PG_UP          &to BASE    &kp N7  &kp N8  &kp N9  &kp FSLH  &trans
&trans  &kp EQUAL   &kp LEFT   &kp DOWN  &kp RIGHT  &kp PG_DN          &kp MINUS   &kp N4  &kp N5  &kp N6  &kp N0    &trans
&trans  &kp DLLR    &kp COLON  &kp STAR  &kp PLUS   &kp PRCNT          &kp COMMA   &kp N1  &kp N2  &kp N3  &kp DOT   &trans
                               &trans    &sc NAVNUM BSPC  &kp TAB      &trans      &lt NAVNUM LS(SPACE)  &bsl SYM SYM
            >;
        };

        sym_layer {
            display-name = "Symbols";
            bindings = <
&trans  &kp CARET  &kp LT    &kp GT    &kp DLLR   &kp PRCNT          &kp AT    &kp AMPS  &kp STAR   &kp SQT    &kp GRAVE  &trans
&trans  &kp LBRC   &kp LPAR  &kp RPAR  &kp RBRC   &kp EQUAL          &kp BSLH  &kp PLUS  &kp MINUS  &kp FSLH   &kp DQT    &trans
&trans  &kp TILDE  &kp LBKT  &kp RBKT  &kp UNDER  &kp HASH           &kp PIPE  &kp EXCL  &kp SEMI   &kp COLON  &kp QMARK  &trans
                             &bsl NAVNUM NAVNUM  &kp SPACE  &kp RET  &trans    &trans    &trans
            >;
        };

        navnum_layer {
            display-name = "NavNum";
            bindings = <
&trans  &kp ESC       &kp HOME    &kp UP      &kp END     &kp PG_UP          &to NUMLOCK  &kp N7  &kp N8  &kp N9  &kp FSLH  &trans
&trans  &kp LC(A)     &kp LEFT    &kp DOWN    &kp RIGHT   &kp PG_DN          &kp MINUS    &kp N4  &kp N5  &kp N6  &kp N0    &trans
&trans  &kp LC(Z)     &kp LC(X)   &kp LC(C)   &kp LC(V)   &kp LC(LS(Z))      &kp COMMA    &kp N1  &kp N2  &kp N3  &kp DOT   &trans
                      &mt LSHFT CAPS  &sc FNMEDIA DEL  &kp LS(TAB)           &trans       &lt FNMEDIA LS(SPACE)  &lbsk RALT RALT
            >;
        };

        fnmedia_layer {
            display-name = "FnMedia";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &out OUT_USB          &bt BT_SEL 2    &kp C_NEXT       &kp C_VOL_UP      &kp C_BRI_UP        &kp SLCK         &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &to GAME              &bt_sel1_clr    &hm LALT C_PP    &hm LCTRL C_MUTE  &hm LGUI C_AL_LOCK  &hm LSHFT PSCRN  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &out OUT_BLE          &bt BT_SEL 0    &kp C_PREV       &kp C_VOL_DN      &kp C_BRI_DN        &kp INS          &trans
                         &trans   &bootloader  &trans            &trans          &sys_reset       &studio_unlock
            >;
        };

        game_layer {
            display-name = "Gaming";
            bindings = <
&none     &kp RET    &kp N9  &kp N8     &kp N7     &kp PSCRN  &none  &none      &none      &none     &none     &none
&none     &kp LCTRL  &kp N3  &kp N2     &kp N1     &kp ESC    &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
&to BASE  &kp N0     &kp N6  &kp N5     &kp N4     &kp TAB    &none  &none      &none      &none     &none     &none
                             &kp LALT   &kp SPACE  &kp LSHFT  &none  &none      &none
            >;
        };
    };
};
