// Selenium (home row mods flavor, vim navigation), ported from https://github.com/OneDeadKey/zmk-config-aekeynox
// QWERTY alphas, US QWERTY host layout, stock ZMK behaviors only.

#define ZMK_POINTING_DEFAULT_SCRL_VAL 25  // default=10 (too slow)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE        0
#define SYM         1
#define VIMNAV      2
#define NUM         3
#define FNMEDIA     4
#define GAME        5

// Timing is key!
#define TAPPING_TERM        300  // tap-preferred hold-taps: Space, sticky Shift/Sym
#define SHORT_TAPPING_TERM  150  // hold-preferred hold-taps: Backspace, Esc, Enter
#define QUICK_TAP           200

#define HRM_TAPPING_TERM    280  // home row mods (timeless, see hml/hmr)
#define HRM_QUICK_TAP       175
#define HRM_PRIOR_IDLE      150

// Key positions, for the home row mods' hold-trigger-key-positions
#define KEYS_L  0  1  2  3  4  5 12 13 14 15 16 17 24 25 26 27 28 29
#define KEYS_R  6  7  8  9 10 11 18 19 20 21 22 23 30 31 32 33 34 35
#define THUMBS 36 37 38 39 40 41

&lt {
    tapping-term-ms = <TAPPING_TERM>;
    quick-tap-ms = <QUICK_TAP>;
};

&mt {
    tapping-term-ms = <SHORT_TAPPING_TERM>;
    quick-tap-ms = <QUICK_TAP>;
};

&sl { ignore-modifiers; };  // keep sticky mods when chained into a sticky layer
&sk { quick-release; };     // release the sticky mod as soon as the next key is pressed

/ {
    behaviors {
        // urob's timeless home row mods: a mod only when the next key is on the other hand
        // (or a thumb), and never while typing fast
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            require-prior-idle-ms = <HRM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            require-prior-idle-ms = <HRM_PRIOR_IDLE>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        sc: space_cadet {  // same as lt, but hold-preferred: layer unless tapped quickly
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <SHORT_TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP>;
            bindings = <&mo>, <&kp>;
        };

        // Sticky layer / sticky key with a more robust timing: tap = one-shot, hold = momentary
        osl: one_shot_layer {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&macro_param_1to1>, <&macro_tap &sl MACRO_PLACEHOLDER>;
        };

        bsl: better_sticky_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            bindings = <&mo>, <&osl>;
        };

        osm: one_shot_modifier {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&macro_param_1to1>, <&macro_tap &sk MACRO_PLACEHOLDER>;
        };

        bsk: better_sticky_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            hold-while-undecided;
            bindings = <&kp>, <&osm>;
        };

        shift_caps: shift_caps {  // tap: sticky shift | double tap: caps word
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bsk LSHFT LSHFT>, <&unshift_caps>;
            mods = <(MOD_LSFT)>;
        };

        unshift_caps: unshift_caps {  // drop the pending sticky shift, then enable caps word
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp K_CANCEL>, <&caps_word>;
        };

        // Go back to the base layer, then press (hold) or stick (tap) a modifier
        lkp: goto_layer_then_keypress {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_tap &to BASE>
                , <&macro_param_1to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                ;
        };

        losm: goto_layer_then_osm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_tap &to BASE>
                , <&macro_param_1to1>
                , <&macro_tap &sk MACRO_PLACEHOLDER>
                ;
        };

        lbsk: bsk_on_other_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            bindings = <&lkp>, <&losm>;
        };

        vim_prev: vim_prev {  // tap: back (Alt+Left) | with Alt/GUI: Shift+` (previous window)
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT)>, <&kp LS(GRAVE)>;
            mods = <(MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LALT|MOD_LGUI)>;
        };

        vim_next: vim_next {  // tap: forward (Alt+Right) | with Alt/GUI: ` (next window)
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(RIGHT)>, <&kp GRAVE>;
            mods = <(MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LALT|MOD_LGUI)>;
        };

        bt_sel1_clr: bt_sel1_clr {  // tap: BT profile 1 | shift + tap: clear profile
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt BT_CLR>;
            mods = <(MOD_LSFT)>;
        };
    };

// Selenium, timeless HRM: pinky Alt, ring Ctrl, middle Shift (shortcuts only), index GUI (most used mod with Hyprland),
// so Ctrl+Alt, Ctrl+Shift and Shift+GUI are adjacent fingers; the same mod order on every layer;
// type capitals with the sticky Shift thumb; Sym twice = sticky AltGr (altgr-intl accents)
//
//   Tab  q w e r t   y u i o p  Bspc
//   Esc  a s d f g   h j k l ;  Ret
//   ⇧    z x c v b   n m , . /  ⇧
//    ⇧ Esc/Num Bspc/VimNav   Spc/VimNav Ret/FnMedia Sym

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q        &kp W        &kp E         &kp R        &kp T            &kp Y            &kp U        &kp I         &kp O        &kp P           &kp BSPC
&kp ESC    &hml LALT A   &hml LCTRL S  &hml LSHFT D  &hml LGUI F  &kp G            &kp H            &hmr LGUI J  &hmr LSHFT K  &hmr LCTRL L  &hmr LALT SEMI   &kp RET
&kp LSHFT  &kp Z        &kp X        &kp C         &kp V        &kp B            &kp N            &kp M        &kp COMMA     &kp DOT      &kp FSLH        &kp RSHFT
                                     &shift_caps   &sc NUM ESC  &sc VIMNAV BSPC  &lt VIMNAV SPACE  &sc FNMEDIA RET  &bsl SYM SYM
            >;
        };

        sym_layer {  // Sym again: sticky AltGr via the base layer (&sl ignores mods, so Sym would stay on for the next key)
            display-name = "Symbols";
            bindings = <
&trans  &kp CARET  &kp LT    &kp GT    &kp DLLR   &kp PRCNT          &kp AT    &kp AMPS  &kp STAR   &kp SQT    &kp GRAVE  &trans
&trans  &kp LBRC   &kp LPAR  &kp RPAR  &kp RBRC   &kp EQUAL          &kp BSLH  &kp PLUS  &kp MINUS  &kp FSLH   &kp DQT    &trans
&trans  &kp TILDE  &kp LBKT  &kp RBKT  &kp UNDER  &kp HASH           &kp PIPE  &kp EXCL  &kp SEMI   &kp COLON  &kp QMARK  &trans
                             &bsl NUM NUM  &kp RET  &kp SPACE  &trans    &trans    &lbsk RALT RALT
            >;
        };

        vimnav_layer {  // left home row: sticky mods (tap = one-shot, hold = held), same order as the HRMs
            display-name = "VimNav";
            bindings = <
&trans  &none           &kp LC(W)         &vim_prev         &vim_next       &kp LS(TAB)       &kp HOME          &kp PG_DN         &kp PG_UP       &kp END            &kp DEL  &trans
&trans  &bsk LALT LALT  &bsk LCTRL LCTRL  &bsk LSHFT LSHFT  &bsk LGUI LGUI  &kp TAB           &kp LEFT          &kp DOWN          &kp UP          &kp RIGHT          &none    &trans
&trans  &kp LC(Z)       &kp LC(X)         &kp LC(C)         &kp LC(V)       &kp LC(LS(Z))     &msc SCRL_LEFT    &msc SCRL_DOWN    &msc SCRL_UP    &msc SCRL_RIGHT    &none    &trans
                   &mt LSHFT CAPS  &trans  &sc FNMEDIA DEL              &mo FNMEDIA       &trans            &lbsk RALT RALT
            >;
        };

        num_layer {  // numpad on the right, plain mods on the left (e.g. GUI + number for workspaces)
            display-name = "Numpad";
            bindings = <
&trans  &none      &none      &none      &none      &none          &kp MINUS  &kp N7  &kp N8  &kp N9  &kp FSLH   &trans
&trans  &kp LALT   &kp LCTRL  &kp LSHFT  &kp LGUI   &none          &kp N0     &kp N1  &kp N2  &kp N3  &kp DOT    &trans
&trans  &none      &none      &none      &none      &none          &kp COMMA  &kp N4  &kp N5  &kp N6  &kp COLON  &trans
                              &trans     &trans     &trans         &trans     &trans  &trans
            >;
        };

        fnmedia_layer {
            display-name = "FnMedia";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &out OUT_USB          &bt BT_SEL 2    &kp C_NEXT       &kp C_VOL_UP      &kp C_BRI_UP        &kp SLCK         &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &to GAME              &bt_sel1_clr    &hmr LGUI C_PP   &hmr LSHFT C_MUTE &hmr LCTRL C_AL_LOCK &hmr LALT PSCRN  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &out OUT_BLE          &bt BT_SEL 0    &kp C_PREV       &kp C_VOL_DN      &kp C_BRI_DN        &kp INS          &trans
                         &sys_reset  &bootloader  &trans         &trans          &trans           &studio_unlock
            >;
        };

        game_layer {
            display-name = "Gaming";
            bindings = <
&none     &kp RET    &kp N9  &kp N8     &kp N7     &kp PSCRN  &none  &none      &none      &none     &none     &none
&none     &kp LCTRL  &kp N3  &kp N2     &kp N1     &kp ESC    &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
&to BASE  &kp N0     &kp N6  &kp N5     &kp N4     &kp TAB    &none  &none      &none      &none     &none     &none
                             &kp LALT   &kp SPACE  &kp LSHFT  &none  &none      &none
            >;
        };
    };
};
