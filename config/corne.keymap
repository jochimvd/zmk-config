// Selenium (home row mods flavor, vim navigation), ported from https://github.com/OneDeadKey/zmk-config-aekeynox
// QWERTY alphas, US QWERTY host layout, stock ZMK behaviors only.

#define ZMK_POINTING_DEFAULT_SCRL_VAL 25  // default=10 (too slow)

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE        0
#define SYM         1
#define VIMNAV      2
#define NUMROW      3
#define FNMEDIA     4
#define GAME        5

// Timing is key!
#define TAPPING_TERM        300  // tap-preferred hold-taps: home row mods, Space, sticky Shift/Sym
#define SHORT_TAPPING_TERM  150  // hold-preferred hold-taps: Backspace, Esc, Enter
#define QUICK_TAP           200

&lt {
    tapping-term-ms = <TAPPING_TERM>;
    quick-tap-ms = <QUICK_TAP>;
};

&mt {
    tapping-term-ms = <SHORT_TAPPING_TERM>;
    quick-tap-ms = <QUICK_TAP>;
};

&sl { ignore-modifiers; };  // keep sticky mods when chained into a sticky layer
&sk { quick-release; };     // release the sticky mod as soon as the next key is pressed

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP>;
            bindings = <&kp>, <&kp>;
        };

        sc: space_cadet {  // same as lt, but hold-preferred: layer unless tapped quickly
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <SHORT_TAPPING_TERM>;
            quick-tap-ms = <QUICK_TAP>;
            bindings = <&mo>, <&kp>;
        };

        // Sticky layer / sticky key with a more robust timing: tap = one-shot, hold = momentary
        osl: one_shot_layer {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&macro_param_1to1>, <&macro_tap &sl MACRO_PLACEHOLDER>;
        };

        bsl: better_sticky_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            bindings = <&mo>, <&osl>;
        };

        osm: one_shot_modifier {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings = <&macro_param_1to1>, <&macro_tap &sk MACRO_PLACEHOLDER>;
        };

        bsk: better_sticky_key {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            hold-while-undecided;
            bindings = <&kp>, <&osm>;
        };

        shift_caps: shift_caps {  // tap: sticky shift | double tap: caps word
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bsk LSHFT LSHFT>, <&unshift_caps>;
            mods = <(MOD_LSFT)>;
        };

        unshift_caps: unshift_caps {  // drop the pending sticky shift, then enable caps word
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp K_CANCEL>, <&caps_word>;
        };

        // Go back to the base layer, then press (hold) or stick (tap) a modifier
        lkp: goto_layer_then_keypress {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_tap &to BASE>
                , <&macro_param_1to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                ;
        };

        losm: goto_layer_then_osm {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            tap-ms = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_tap &to BASE>
                , <&macro_param_1to1>
                , <&macro_tap &sk MACRO_PLACEHOLDER>
                ;
        };

        lbsk: bsk_on_other_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <TAPPING_TERM>;
            bindings = <&lkp>, <&losm>;
        };

        vim_prev: vim_prev {  // tap: back (Alt+Left) | with Alt/GUI: Shift+` (previous window)
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(LEFT)>, <&kp LS(GRAVE)>;
            mods = <(MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LALT|MOD_LGUI)>;
        };

        vim_next: vim_next {  // tap: forward (Alt+Right) | with Alt/GUI: ` (next window)
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(RIGHT)>, <&kp GRAVE>;
            mods = <(MOD_LALT|MOD_LGUI)>;
            keep-mods = <(MOD_LALT|MOD_LGUI)>;
        };

        bt_sel1_clr: bt_sel1_clr {  // tap: BT profile 1 | shift + tap: clear profile
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1>, <&bt BT_CLR>;
            mods = <(MOD_LSFT)>;
        };
    };

// Selenium HRM, GUI and Ctrl swapped (GUI is the most used mod with Hyprland): pinky -, ring Ctrl, middle GUI, index Alt; Shift and Sym are sticky thumb keys
//
//   Tab  q w e r t   y u i o p  Bspc
//   Esc  a s d f g   h j k l ;  Ret
//   ⇧    z x c v b   n m , . /  ⇧
//    ⇧ Bspc/VimNav Esc/FnMedia   Ret/NumRow Spc/VimNav Sym

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W       &kp E        &kp R       &kp T            &kp Y          &kp U       &kp I        &kp O       &kp P     &kp BSPC
&kp ESC    &kp A  &hm LCTRL S  &hm LGUI D  &hm LALT F  &kp G            &kp H          &hm LALT J  &hm LGUI K  &hm LCTRL L  &kp SEMI  &kp RET
&kp LSHFT  &kp Z  &kp X       &kp C        &kp V       &kp B            &kp N          &kp M       &kp COMMA    &kp DOT     &kp FSLH  &kp RSHFT
                              &shift_caps  &sc VIMNAV BSPC  &sc FNMEDIA ESC  &sc NUMROW RET  &lt VIMNAV SPACE  &bsl SYM SYM
            >;
        };

        sym_layer {
            display-name = "Symbols";
            bindings = <
&trans  &kp CARET  &kp LT    &kp GT    &kp DLLR   &kp PRCNT          &kp AT    &kp AMPS  &kp STAR   &kp SQT    &kp GRAVE  &trans
&trans  &kp LBRC   &kp LPAR  &kp RPAR  &kp RBRC   &kp EQUAL          &kp BSLH  &kp PLUS  &kp MINUS  &kp FSLH   &kp DQT    &trans
&trans  &kp TILDE  &kp LBKT  &kp RBKT  &kp UNDER  &kp HASH           &kp PIPE  &kp EXCL  &kp SEMI   &kp COLON  &kp QMARK  &trans
                             &bsl NUMROW NUMROW  &kp SPACE  &kp RET  &trans    &trans    &trans
            >;
        };

        vimnav_layer {
            display-name = "VimNav";
            bindings = <
&trans  &none      &kp LC(W)  &vim_prev    &vim_next  &none             &kp HOME          &kp PG_DN         &kp PG_UP       &kp END            &kp DEL  &trans
&trans  &kp LC(A)  &kp LC(S)  &kp LS(TAB)  &kp TAB    &none             &kp LEFT          &kp DOWN          &kp UP          &kp RIGHT          &none    &trans
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)    &kp LC(V)  &kp LC(LS(Z))     &msc SCRL_LEFT    &msc SCRL_DOWN    &msc SCRL_UP    &msc SCRL_RIGHT    &none    &trans
                   &mt LSHFT CAPS  &sc FNMEDIA DEL  &trans              &trans            &mo FNMEDIA       &lbsk RALT RALT
            >;
        };

        numrow_layer {  // numbers on the home row, shifted numbers above them
            display-name = "NumRow";
            bindings = <
&trans  &kp RS(N1)  &kp RS(N2)  &kp RS(N3)  &kp RS(N4)  &kp RS(N5)          &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &trans
&trans  &kp N1      &kp N2      &kp N3      &kp N4      &kp N5              &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &trans
&trans  &none       &none       &none       &none       &none               &kp MINUS   &kp COMMA   &kp DOT     &kp COLON   &kp FSLH    &trans
                                &trans      &kp RS(SPACE)  &trans           &trans      &kp LS(SPACE)  &kp RALT
            >;
        };

        fnmedia_layer {
            display-name = "FnMedia";
            bindings = <
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &out OUT_USB          &bt BT_SEL 2    &kp C_NEXT       &kp C_VOL_UP      &kp C_BRI_UP        &kp SLCK         &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &to GAME              &bt_sel1_clr    &hm LALT C_PP    &hm LGUI C_MUTE  &hm LCTRL C_AL_LOCK  &hm LSHFT PSCRN  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &out OUT_BLE          &bt BT_SEL 0    &kp C_PREV       &kp C_VOL_DN      &kp C_BRI_DN        &kp INS          &trans
                         &trans   &bootloader  &trans            &trans          &sys_reset       &studio_unlock
            >;
        };

        game_layer {
            display-name = "Gaming";
            bindings = <
&none     &kp RET    &kp N9  &kp N8     &kp N7     &kp PSCRN  &none  &none      &none      &none     &none     &none
&none     &kp LCTRL  &kp N3  &kp N2     &kp N1     &kp ESC    &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
&to BASE  &kp N0     &kp N6  &kp N5     &kp N4     &kp TAB    &none  &none      &none      &none     &none     &none
                             &kp LALT   &kp SPACE  &kp LSHFT  &none  &none      &none
            >;
        };
    };
};
